# ==============================================================================
# TEAMYAK (팀약) — 환경변수 설정 템플릿 (.env.example)
#
# 주의: 이 파일은 예시 템플릿입니다. 실제 비밀키는 절대 git에 커밋하지 마시고,
# 로컬 개발 및 스테이징 환경에서는 이 파일을 복사하여 `.env.local`로 생성해 사용하십시오.
# ==============================================================================

# [1] 애플리케이션 실행 환경 및 베이스 URL
NODE_ENV="development"
APP_ENV="staging"
BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [2] Supabase Cloud PostgreSQL
# 주의: APP_ENV=production 또는 APP_ENV=staging 환경에서 클라우드 연결 정보가 없으면
# 프로덕션 가드에 의해 서비스가 중단(FATAL ERROR)되며 로컬 JSON 폴백이 원천 차단됩니다.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"

# [3] 자체 세션 및 OAuth 보안 서명 키 (필수)
# 64자리 무작위 16진수 문자열 권장: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_HMAC_SECRET="teamyak_staging_session_hmac_secret_must_be_at_least_32_characters_long_123456"

# [4] Kakao Developers (https://developers.kakao.com)
# REST API 키 및 보안 코드(Client Secret)
KAKAO_CLIENT_ID="your_kakao_rest_api_key"
KAKAO_CLIENT_SECRET="your_kakao_client_secret_code"
KAKAO_REDIRECT_URI="http://localhost:3000/api/auth?mode=kakao_callback"
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY="your_kakao_javascript_key"

# [5] Google Cloud Console (https://console.cloud.google.com)
# Google Calendar API v3 및 OAuth 2.0 Web Client
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/google?mode=callback"

# [6] Naver Developers (https://developers.naver.com)
# 네이버 검색 (뉴스 및 지역 검색) API
NAVER_CLIENT_ID="your_naver_client_id"
NAVER_CLIENT_SECRET="your_naver_client_secret"
